# No API keys were required through Epic 2 (deterministic parsing + MCP tools, no LLM calls).
# LangSmith tracing vars are added later, in Epic 8.

# SEC EDGAR requires a compliant User-Agent identifying the requester (fair-access policy).
# sec_edgar_lookup fails fast with a clear error if this is unset.
SEC_EDGAR_USER_AGENT="portfolio-value-agent <your-email>"

# Required by src/parsers/broker_llm.py's self-healing CSV-schema fallback
# (only called when a CSV's header doesn't match a known broker format).
OPENAI_API_KEY="sk-..."

# Optional: override the model used for schema-mapping (default: gpt-4o-mini).
# BROKER_LLM_MODEL="gpt-4o-mini"

# Required by scripts/risk_agent_eval.py's LangSmith eval harness (Epic 5).
# Sign up free at https://smith.langchain.com, create an API key under
# Settings > API Keys. NOT the same as LANGCHAIN_TRACING_V2 auto-tracing
# (that's Epic 8) - this only drives the standalone eval script's
# langsmith.Client() calls. If unset, the eval script prints a message and
# exits 0 rather than failing - pytest never depends on this.
LANGSMITH_API_KEY="lsv2_..."

# Optional: LangSmith project name the eval dataset/runs are grouped under
# (default: "portfolio-value-agent-risk-eval" if unset).
# LANGSMITH_PROJECT="portfolio-value-agent-risk-eval"

# Epic 8: LangSmith auto-tracing for the full LangGraph pipeline (src/main.py,
# src/app.py) - distinct from the LANGSMITH_API_KEY above, which only drives
# scripts/risk_agent_eval.py's standalone eval harness (Epic 5). In practice
# LangChain/LangSmith API keys are interchangeable - the same key from
# smith.langchain.com works for both LANGSMITH_API_KEY and LANGCHAIN_API_KEY -
# but they're separate env vars because LangChain's SDK reads the LANGCHAIN_*
# names for its auto-instrumentation, not LANGSMITH_API_KEY. No code wiring
# is needed beyond these vars - tracing is picked up globally by langchain-core.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY="lsv2_..."

# Optional: project name traces are grouped under in the LangSmith UI
# (default: "default" if unset). Distinct from LANGSMITH_PROJECT above.
LANGCHAIN_PROJECT="portfolio-value-agent"

# If your LangSmith account/workspace is in the EU region (check by seeing
# whether smith.langchain.com redirects you to eu.smith.langchain.com when
# logged in), uncomment this - otherwise traces will fail with a silent 403
# Forbidden against the US default endpoint even though the key is valid.
# LANGCHAIN_ENDPOINT="https://eu.api.smith.langchain.com"

# Optional: raises OpenFIGI's rate limit (25 req/min -> ~250 req/min) and
# batch size (10 -> 100 ISINs/request). Free signup at openfigi.com. Only
# used by src/parsers/isin_resolver.py's ISIN-to-ticker lookup, which covers
# ISINs the static ISIN_TO_TICKER table in base_parser.py misses (mostly
# European ETFs/foreign listings) - resolution works without a key, just in
# smaller batches for large portfolios.
# OPENFIGI_API_KEY="..."
