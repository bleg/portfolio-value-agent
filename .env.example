# No API keys are required yet for Epic 1 (deterministic parsing only, no LLM calls).
# OPENAI_API_KEY and LangSmith tracing vars are added starting Epic 3.

# SEC EDGAR requires a compliant User-Agent identifying the requester (fair-access policy).
# sec_edgar_lookup fails fast with a clear error if this is unset.
SEC_EDGAR_USER_AGENT="portfolio-value-agent <your-email>"
